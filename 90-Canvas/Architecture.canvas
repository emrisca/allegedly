			"color": "2"
		},
		{
			"id": "n-sidecars",
			"type": "text",
			"text": "## Optional Out-of-Process Sidecars\nNautilusTrader (LGPL-3.0-only, Parquet/JSON-RPC isolated)\nDuckDB v2.0.1 (MIT, read-only ad-hoc SQL over Parquet)\nQuantConnect Lean (Apache-2.0, optional backtest)\nZero Static Linking in allegedly-* Core\n(ADRs 0001, 0006, 0007)",
			"x": 630,
			"y": 155,
